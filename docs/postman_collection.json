{
  "info": {
    "name": "AIRA-DBMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"admin\", \"password\": \"admin123\" }"
        }
      }
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/students"
          }
        },
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/students",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Demo Student\", \"email\": \"demo@student.test\", \"phone\": \"9999999999\", \"grade_level\": \"Grade 9\" }"
            }
          }
        }
      ]
    },
    {
      "name": "Courses",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/courses"
      }
    },
    {
      "name": "Enrollments",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/enrollments",
        "body": {
          "mode": "raw",
          "raw": "{ \"student_id\": 1, \"course_id\": 1, \"status\": \"active\" }"
        }
      }
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Student Performance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/dashboard/student-performance"
          }
        },
        {
          "name": "Course Utilization",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/dashboard/course-utilization"
          }
        },
        {
          "name": "Faculty Workload",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/dashboard/faculty-workload"
          }
        },
        {
          "name": "Attendance Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/dashboard/attendance-summary"
          }
        }
      ]
    }
  ]
}
