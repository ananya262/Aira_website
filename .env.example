# ═══════════════════════════════════════════════════════
# .env.example — AIRA Study Centre
# Required environment variables for production deployment
# ═══════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# Usage: node build.js reads .env and injects values into HTML/JS files.
# ═══════════════════════════════════════════════════════

# ── Module 1: Analytics ──
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
HOTJAR_SITE_ID=XXXXXXX

# ── Module 2: Google Sheets Webhook ──
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ── Module 3: Security ──
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY

# ── Module 4: Supabase ──
# AIRA-DBMS Express + MySQL API
# Local development API base
AIRA_API_BASE_URL=http://localhost:3000/api
# Database (update these to match your local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=aira_app
DB_PASSWORD=CHANGE_ME
DB_NAME=aira_dbms
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DB_NAME=aira_dbms
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

